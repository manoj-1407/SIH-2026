# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches & Environment
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
env/
.env
node_modules/

# Submission Archives & Binaries
*.zip
*.tar.gz
*.7z
*.rar

# Private keys & secrets (Strict: never commit private keys)
*.priv
*.key
*.pem
id_rsa
id_ed25519

# Forensic / Attack payloads
*.img
*_shadow
*_evil_payload*

